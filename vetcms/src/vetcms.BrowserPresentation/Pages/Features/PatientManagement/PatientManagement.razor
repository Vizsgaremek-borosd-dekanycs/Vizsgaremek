@page "/patient-management/animal-management"
@page "/patient-management/animal-management/user/{strUserId}"

<PageTitle>Páciensek kezelése</PageTitle>

@using vetcms.BrowserPresentation.Components
@using vetcms.BrowserPresentation.Utility
@using vetcms.ClientApplication.Common.Abstract.CommandAbstraction
@using vetcms.ClientApplication.Features.IAM.GetUser
@using vetcms.ClientApplication.Features.PatientClassification.ListAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.CreateAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.DeleteAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.GetAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.ModifyAnimalBreed
@using vetcms.ClientApplication.Features.PatientManagement.CreatePatient
@using vetcms.ClientApplication.Features.PatientManagement.DeletePatient
@using vetcms.ClientApplication.Features.PatientManagement.GetPatient
@using vetcms.ClientApplication.Features.PatientManagement.ListPatients
@using vetcms.ClientApplication.Features.PatientManagement.ModifyPatient
@using vetcms.SharedModels.Common.Dto
@inject IDialogService DialogService
@inject IToastService ToastService;
@inject MediatR.IMediator Mediator
@inject NavigationManager Navigation

<FluentCard style="overflow:auto;">
    @if (IsUserAnimalLookup)
    {
        <h1>Állatok megtekintése: @Username</h1>
    }
    <FluentGrid>
        <FluentGridItem xs="12">
            <FluentToolbar id="toolbar-fluent-components" style="width:100%">
                <PermissionWrapper RequiredPermissions="[PermissionFlags.CAN_ADD_PATIENT]">
                    <FluentButton Disabled="isBusy" @onclick="@OpenCreateAnimalDialog" style="padding-bottom: 5px;" IconStart="@(new Icons.Regular.Size16.AddCircle())" Appearance="Appearance.Accent">Új állat</FluentButton>
                </PermissionWrapper>
                <PermissionWrapper RequiredPermissions="[PermissionFlags.CAN_DELETE_PATIENT]">
                    <FluentButton Disabled="isBusy" @onclick="@DeleteAnimal" style="padding-bottom: 5px;" IconStart="@(new Icons.Regular.Size16.DismissCircle())" Appearance="Appearance.Accent">Törlés</FluentButton>
                </PermissionWrapper>
                @if(!IsUserAnimalLookup)
                {
                    <div slot="end">
                        <FluentSearch Disabled="isBusy" @bind-Value="searchValue" Immediate="true" ImmediateDelay="300" @bind-Value:after="SearchValueChanged" AutoComplete="off" />
                    </div>
                }
            </FluentToolbar>
        </FluentGridItem>
        <FluentGridItem xs="12">
            <FluentDataGrid Virtualize="true"
            ItemsProvider="animalProvider"
            GenerateHeader="GenerateHeaderOption.Sticky"
            Style="min-width: max-content;"
            Pagination="@pagination"
            @ref="dataGrid">
                <SelectColumn TGridItem="SelectableAnimalDto"
                SelectMode="DataGridSelectMode.Multiple"
                SelectFromEntireRow="false"
                OnSelect="@(e => e.Item.Selected = e.Selected)"
                SelectAllDisabled="true"
                @bind-SelectedItems="selectedAnimals" />
                <PropertyColumn Title="Azonosító" Property="@(p => p.Id)" Sortable="true" />
                <PropertyColumn Title="Születési dátum" Property="@(p => p.DateOfBirth)" Sortable="true" />
                <PropertyColumn Title="Név" Property="@(p => p.Name)" Sortable="true" />
                <PropertyColumn Title="Nem" Property="@(p => p.Gender)" Sortable="true" />
                <PropertyColumn Title="Microchip szám" Property="@(p => p.MicrochipNumber)" Sortable="true" />

                <TemplateColumn Title="Művelet" Align="@Align.End">
                    <PermissionWrapper RequiredPermissions="[PermissionFlags.CAN_MODIFY_PATIENT]">
                        <FluentButton Disabled="isBusy" aria-label="Szerkesztés" OnClick="@(async ()=> await OpenEditAnimalDialog(context))" IconStart="@(new Icons.Regular.Size16.Edit())" />
                    </PermissionWrapper>
                    <PermissionWrapper RequiredPermissions="[PermissionFlags.CAN_VIEW_PATIENT_TREATMENTS]">
                        <FluentButton Disabled="isBusy" aria-label="Kezelések megtekintése" OnClick="@(()=> Navigation.NavigateTo($"/patient-management/patients/{context.Id}/treatments"))" IconStart="@(new Icons.Regular.Size16.CalendarEdit())" />
                    </PermissionWrapper>
                </TemplateColumn>
            </FluentDataGrid>
        </FluentGridItem>
        <FluentGridItem xs="12">
            <FluentPaginator State="@pagination" />
        </FluentGridItem>
    </FluentGrid>
</FluentCard>

@code {
    [Parameter]
    public string strUserId { get; set; }
    public bool IsUserAnimalLookup { get => !string.IsNullOrEmpty(strUserId);}

    private string searchValue = "";
    GridItemsProvider<SelectableAnimalDto> animalProvider = default!;
    bool isBusy = false;
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    IEnumerable<SelectableAnimalDto>? selectedAnimals = new List<SelectableAnimalDto>();
    private FluentDataGrid<SelectableAnimalDto> dataGrid;

    public string Username { get; set; }

    private class SelectableAnimalDto : PatientDto
    {
        public bool Selected { get; set; } = false;

    }

    protected override async Task OnInitializedAsync()
    {
        animalProvider = gridItemsProviderResult;
        if (IsUserAnimalLookup)
        {
            if (int.TryParse(strUserId, out int userId))
            {
                UserDto user = await GetUserById(userId);
                Username = $"{user.LastName} {user.FirstName} ({user.DateOfBirth})";
            }
        }
    }

    private async Task SearchValueChanged()
    {
        await dataGrid.RefreshDataAsync();
    }

    private async ValueTask<GridItemsProviderResult<SelectableAnimalDto>> gridItemsProviderResult(GridItemsProviderRequest<SelectableAnimalDto> req)
    {
        List<PatientDto> patients = new List<PatientDto>();
        var query = new AnimalListClientQuery()
            {
                SearchTerm = searchValue,
                Skip = req.StartIndex,
                Take = req.Count.HasValue ? req.Count.Value : 10
            };
        if (IsUserAnimalLookup)
        {
            if (int.TryParse(strUserId, out int userId))
            {
                query.OwnerId = userId;
            }
        }

        var data = await ToastService.ShowIndeterminateProgressToast(Mediator.Send(query), "Kérjük várjon...", "Állatok betöltése folyamatban...");

        if (data == null)
        {
            data = new AnimalListClientQueryResponse();
        }

        List<SelectableAnimalDto> animalBreeds = data.Patients.Select(u => new SelectableAnimalDto
            {
                Id = u.Id,
                TypeId = u.TypeId,
                MicrochipNumber = u.MicrochipNumber,
                Weight = u.Weight,
                Gender = u.Gender,
                Name = u.Name,
                OwnerId = u.OwnerId,
                BreedId = u.BreedId,
            }).ToList();

        selectedAnimals = new List<SelectableAnimalDto>();

        return GridItemsProviderResult.From(
            items: animalBreeds,
            totalItemCount: data.ResoultCount);
    }

    public async Task DeleteAnimal()
    {
        if (!selectedAnimals.Any())
        {
            DialogService.ShowError("Nincsenek elemek kijelölve!");
            return;
        }
        isBusy = true;
        var dialog = await DialogService.ShowConfirmationAsync("Biztosan el szeretnéd távolítani az Állato(ka)t?");
        var result = await dialog.Result;
        bool canceled = result.Cancelled;

        DeletePatientClientCommand command = new DeletePatientClientCommand()
            {
                AnimalIds = selectedAnimals.Select(u => u.Id).ToList()
            };

        if (!canceled)
        {
            await ToastService.ShowIndeterminateProgressToast(Mediator.Send(command), "Kérjük várjon...", "Állatok törlése folyamatban...");
        }

        await dataGrid.RefreshDataAsync();
        isBusy = false;
    }

    private async Task<UserDto> GetUserById(int id)
    {
        var userQuery = await Mediator.Send(new GetUserClientQuery(id));
        if (userQuery != null && userQuery.User != null)
        {
            return userQuery.User;
        }
        return new UserDto();
    }

    private async Task<DialogResult?> ShowAnimalEditDialog(string title, PatientDto animal)
    {
        DialogParameters parameters = new()
            {
                Title = title,
                PrimaryAction = "Mentés",
                PrimaryActionEnabled = true,
                SecondaryAction = "Mégsem",
                Width = "fit-content",
                TrapFocus = true,
                Modal = true,
                PreventScroll = true
            };
        IDialogReference dialog = await DialogService.ShowDialogAsync<EditPatientDialog>(animal, parameters);
        DialogResult? result = await dialog.Result;
        return result;
    }

    private async Task OpenCreateAnimalDialog()
    {
        isBusy = true;
        Console.WriteLine($"Open dialog create animal");

        PatientDto simpleAnimalBreed = new PatientDto();

        var result = await ShowAnimalEditDialog("Új Állat létrehozása", simpleAnimalBreed);

        if (result.Data is not null)
        {
            PatientDto? animalData = result.Data as PatientDto;
            Console.WriteLine($"create animal Dialog closed by {animalData?.Name} - Canceled: {result.Cancelled}");
            if (!result.Cancelled)
            {
                await ToastService.ShowIndeterminateProgressToast(SubmitNewAnimalData(animalData), "Kérjük várjon...", "Állat adatainak mentése");
            }
        }
        else
        {
            Console.WriteLine($"create animal Dialog closed - Canceled: {result.Cancelled}");
        }
        isBusy = false;
    }

    private async Task OpenEditAnimalDialog(PatientDto animalBreed)
    {
        isBusy = true;
        int id = animalBreed.Id;
        Console.WriteLine($"Open dialog edit animal breed");
        var simpleAnimalBreed = await ToastService.ShowIndeterminateProgressToast(LoadAnimalData(id), "Kérjük várjon...", "Állat adatainak betöltése");

        var result = await ShowAnimalEditDialog("Állat szerkesztése", simpleAnimalBreed);

        if (result.Data is not null)
        {
            PatientDto? editResult = result.Data as PatientDto;
            Console.WriteLine($"Edit animal breed Dialog closed by {editResult?.Name} - Canceled: {result.Cancelled}");
            if (!result.Cancelled)
            {
                await ToastService.ShowIndeterminateProgressToast(SubmitEditAnimalData(editResult), "Kérjük várjon...", "Állat adatainak mentése");
            }
        }
        else
        {
            Console.WriteLine($"Edit animal breed Dialog closed - Canceled: {result.Cancelled}");
        }

        isBusy = false;
    }

    private async Task<PatientDto> LoadAnimalData(int id)
    {
        var query = new GetPatientClientQuery()
            {
                PatientId = id
            };

        var data = await Mediator.Send(query);

        return data.PatientModel;
    }

    private async Task SubmitNewAnimalData(PatientDto newAnimalDto)
    {
        await Task.Delay(10);
        CreatePatientCommand createNewAnimalCommand = new CreatePatientCommand()
            {
                NewAnimalModel = newAnimalDto
            };
        await Mediator.Send(createNewAnimalCommand);
        await dataGrid.RefreshDataAsync();
    }

    private async Task SubmitEditAnimalData(PatientDto editedAnimalBreed)
    {
        ModifyPatientClientCommand command = new ModifyPatientClientCommand()
        {
            Id = editedAnimalBreed.Id,
            PatientModel = editedAnimalBreed
        };

        await Mediator.Send(command);
        await dataGrid.RefreshDataAsync();
    }
}
