@page "/patient-management/patients/{strPatientId}/treatments"
@using vetcms.BrowserPresentation.Components
@using vetcms.BrowserPresentation.Utility
@using vetcms.ClientApplication.Common.Abstract.CommandAbstraction
@using vetcms.ClientApplication.Common.IAM.Commands.AuthenticationStatus
@using vetcms.ClientApplication.Features.IAM.GetUser
@using vetcms.ClientApplication.Features.PatientClassification.ListAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.CreateAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.DeleteAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.GetAnimalBreed
@using vetcms.ClientApplication.Features.PatientClassification.ModifyAnimalBreed
@using vetcms.ClientApplication.Features.PatientManagement.CreatePatient
@using vetcms.ClientApplication.Features.PatientManagement.DeletePatient
@using vetcms.ClientApplication.Features.PatientManagement.GetPatient
@using vetcms.ClientApplication.Features.PatientManagement.ListPatients
@using vetcms.SharedModels.Common.Dto
@inject IDialogService DialogService
@inject IToastService ToastService;
@inject MediatR.IMediator Mediator

<FluentCard style="overflow:auto;">
    <h1>Pid: @{
            @strPatientId;
        }</h1>
    <FluentGrid>
        <FluentGridItem xs="12">
            <FluentToolbar id="toolbar-fluent-components" style="width:100%">
                <PermissionWrapper RequiredPermissions="[PermissionFlags.CAN_ADD_ANIMAL_BREED]">
                    <FluentButton Disabled="isBusy" @onclick="@OpenCreateTreatmentDialog" style="padding-bottom: 5px;" IconStart="@(new Icons.Regular.Size16.PersonAdd())" Appearance="Appearance.Accent">Új állat</FluentButton>
                </PermissionWrapper>
                <PermissionWrapper RequiredPermissions="[PermissionFlags.CAN_DELETE_ANIMAL_BREED]">
                    <FluentButton Disabled="isBusy" @onclick="@DeleteTreatment" style="padding-bottom: 5px;" IconStart="@(new Icons.Regular.Size16.PersonDelete())" Appearance="Appearance.Accent">Törlés</FluentButton>
                </PermissionWrapper>
                <div slot="end">
                    <FluentSearch Disabled="isBusy" @bind-Value="searchValue" Immediate="true" ImmediateDelay="300" @bind-Value:after="SearchValueChanged" AutoComplete="off" />
                </div>
            </FluentToolbar>
        </FluentGridItem>
        <FluentGridItem xs="12">
            <FluentDataGrid Virtualize="true"
                            ItemsProvider="treatmentProvider"
                            GenerateHeader="GenerateHeaderOption.Sticky"
                            Style="min-width: max-content;"
                            Pagination="@pagination"
                            @ref="dataGrid">
                <SelectColumn TGridItem="SelectableTreatmentDto"
                              SelectMode="DataGridSelectMode.Multiple"
                              SelectFromEntireRow="false"
                              OnSelect="@(e => e.Item.Selected = e.Selected)"
                              SelectAllDisabled="true"
                              @bind-SelectedItems="selectedTreatments" />
                <PropertyColumn Title="Azonosító" Property="@(p => p.Id)" Sortable="true" />
                <PropertyColumn Title="Dátum" Property="@(p => p.DateOfTreatment)" Sortable="true" />
                <PropertyColumn Title="Kezelés típusa" Property="@(p => p.Type)" Sortable="true" />
                <PropertyColumn Title="Tűnetek" Property="@(p => p.Symptoms)" Sortable="true" />
                <PropertyColumn Title="Control vizsgálat" Property="@(p => p.FollowUpDate)" Sortable="true" />

                <TemplateColumn Title="Művelet" Align="@Align.End">
                    <PermissionWrapper RequiredPermissions="[PermissionFlags.CAN_MODIFY_ANIMAL_TYPES]">
                        <FluentButton Disabled="isBusy" aria-label="Szerkesztés" OnClick="@(async ()=> await OpenEditTreatmentDialog(context))" IconStart="@(new Icons.Regular.Size16.Edit())" />
                    </PermissionWrapper>
                </TemplateColumn>
            </FluentDataGrid>
        </FluentGridItem>
        <FluentGridItem xs="12">
            <FluentPaginator State="@pagination" />
        </FluentGridItem>
    </FluentGrid>
</FluentCard>

@code {



    [Parameter]
    public string strPatientId { get; set; }
    public int PatientId { get => int.Parse(strPatientId); }


    private string searchValue = "";
    GridItemsProvider<SelectableTreatmentDto> treatmentProvider = default!;
    bool isBusy = false;
    PaginationState pagination = new PaginationState { ItemsPerPage = 10 };
    IEnumerable<SelectableTreatmentDto>? selectedTreatments = new List<SelectableTreatmentDto>();
    private FluentDataGrid<SelectableTreatmentDto> dataGrid;


    private class SelectableTreatmentDto : TreatmentDto
    {
        public bool Selected { get; set; } = false;
    }

    protected override async Task OnInitializedAsync()
    {
        treatmentProvider = gridItemsProviderResult;
    }

    private async Task SearchValueChanged()
    {
        await dataGrid.RefreshDataAsync();
    }

    private async ValueTask<GridItemsProviderResult<SelectableTreatmentDto>> gridItemsProviderResult(GridItemsProviderRequest<SelectableTreatmentDto> req)
    {
        var query = new GetTreatmentByPatientsClientQuery()
            {
                PatientId = PatientId,
            };

        var data = await ToastService.ShowIndeterminateProgressToast(Mediator.Send(query), "Kérjük várjon...", "Kezelések betöltése folyamatban...");

        if (data == null)
        {

            data = new GetTreatmentByPatientsClientQueryResponse();

        }

        List<SelectableTreatmentDto> treatments = data.Treatments.Select(u => new SelectableTreatmentDto
            {
                Id = u.Id,
                PatientId = u.PatientId,
                DoctorId = u.DoctorId,
                DateOfTreatment = u.DateOfTreatment,
                Type = u.Type,
                Symptoms = u.Symptoms,
                FollowUpDate = u.FollowUpDate,
                Diagnosis = u.Diagnosis,
                Medications = u.Medications,
                Procedure = u.Procedure,
                Description = u.Description,
            }).ToList();

        selectedTreatments = new List<SelectableTreatmentDto>();

        return GridItemsProviderResult.From(
            items: treatments,

            totalItemCount: treatments.Count);

    }

    public async Task DeleteTreatment()
    {
        if (!selectedTreatments.Any())
        {
            DialogService.ShowError("Nincsenek elemek kijelölve!");
            return;
        }
        isBusy = true;
        var dialog = await DialogService.ShowConfirmationAsync("Biztosan el szeretnéd távolítani az Kezeléseket?");
        var result = await dialog.Result;
        bool canceled = result.Cancelled;



        DeletePatientTreatmentClientCommand command = new DeletePatientTreatmentClientCommand()
            {
                TreatmentIds = selectedTreatments.Select(u => u.Id).ToList()
            };

        if (!canceled)
        {
            await ToastService.ShowIndeterminateProgressToast(Mediator.Send(command), "Kérjük várjon...", "Kezelések törlése folyamatban...");
        }

        await dataGrid.RefreshDataAsync();
        isBusy = false;
    }

    private async Task<DialogResult?> ShowTreatmentEditDialog(string title, TreatmentDto treatment)
    {
        DialogParameters parameters = new()
            {
                Title = title,
                PrimaryAction = "Mentés",
                PrimaryActionEnabled = true,
                SecondaryAction = "Mégsem",
                Width = "fit-content",
                TrapFocus = true,
                Modal = true,
                PreventScroll = true
            };
        IDialogReference dialog = await DialogService.ShowDialogAsync<EditTreatmentDialog>(treatment, parameters);
        DialogResult? result = await dialog.Result;
        return result;
    }

    private async Task OpenCreateTreatmentDialog()
    {
        isBusy = true;
        Console.WriteLine($"Open dialog create treatment");

        AuthenticatedStatusQuery currentUserQuery = new();
        var currentUserQueryResponse = await Mediator.Send(currentUserQuery);

        TreatmentDto treatment = new TreatmentDto();
        treatment.PatientId = PatientId;
        treatment.DoctorId = currentUserQueryResponse.CurrentUser.Id;

        var result = await ShowTreatmentEditDialog("Új kezelés létrehozása", treatment);

        if (result.Data is not null)
        {
            TreatmentDto? treatmentData = result.Data as TreatmentDto;
            Console.WriteLine($"create animal Dialog closed by {treatmentData?.Medications} - Canceled: {result.Cancelled}");
            if (!result.Cancelled)
            {
                await ToastService.ShowIndeterminateProgressToast(SubmitNewTreatmentData(treatmentData), "Kérjük várjon...", "Állat adatainak mentése");
            }
        }
        else
        {
            Console.WriteLine($"create animal Dialog closed - Canceled: {result.Cancelled}");
        }
        isBusy = false;
    }

    private async Task OpenEditTreatmentDialog(TreatmentDto treatment)
    {
        isBusy = true;
        int id = treatment.Id;
        Console.WriteLine($"Open dialog edit treatment");
        var simpleAnimalBreed = await ToastService.ShowIndeterminateProgressToast(LoadTreatmentData(id), "Kérjük várjon...", "Kezelés adatainak betöltése");

        var result = await ShowTreatmentEditDialog("Kezelés szerkesztése", simpleAnimalBreed);

        if (result.Data is not null)
        {
            TreatmentDto? editResult = result.Data as TreatmentDto;
            Console.WriteLine($"Edit treatment Dialog closed by {editResult?.Procedure} - Canceled: {result.Cancelled}");
            if (!result.Cancelled)
            {
                await ToastService.ShowIndeterminateProgressToast(SubmitEditTreatmentData(editResult), "Kérjük várjon...", "Kezelés adatainak mentése");
            }
        }
        else
        {
            Console.WriteLine($"Edit treatment Dialog closed - Canceled: {result.Cancelled}");
        }

        isBusy = false;
    }

    private async Task<TreatmentDto> LoadTreatmentData(int id)
    {
        var query = new GetTreatmentByIdClientQuery()
            {
                TreatmentId = id
            };

        var data = await Mediator.Send(query);

        return data.TreatmentModel;
    }

    private async Task SubmitNewTreatmentData(TreatmentDto editedTreatmentData)
    {
        CreatePatientTreatmentClientCommand createNewTreatmentCommand = new CreatePatientTreatmentClientCommand()
            {
                Treatmentmodel = editedTreatmentData
            };
        await Mediator.Send(createNewTreatmentCommand);
        await dataGrid.RefreshDataAsync();
    }

    private async Task SubmitEditTreatmentData(TreatmentDto editTreatmentData)
    {
        CreatePatientTreatmentClientCommand createNewTreatmentCommand = new CreatePatientTreatmentClientCommand()
            {
                Treatmentmodel = editTreatmentData
            };
        await Mediator.Send(createNewTreatmentCommand);
        await dataGrid.RefreshDataAsync();
    }
}
