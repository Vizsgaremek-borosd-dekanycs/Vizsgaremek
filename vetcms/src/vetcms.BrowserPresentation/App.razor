<FluentToastProvider MaxToastCount="10" />
<FluentMenuProvider />
<Router AppAssembly="@typeof(App).Assembly">
    <Found Context="routeData">
        <FluentDialogProvider />
        <RouteView @rendermode="InteractiveAuto" RouteData="@routeData" DefaultLayout="@typeof(MainLayout)" />
    </Found>
    <NotFound>
        <PageTitle>Az oldal nem található.</PageTitle>
        <LayoutView Layout="@typeof(MainLayout)">
            <p role="alert">Sajnos itt nincs semmi.</p>
        </LayoutView>
    </NotFound>
</Router>
